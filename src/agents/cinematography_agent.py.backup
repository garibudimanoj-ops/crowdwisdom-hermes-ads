from __future__ import annotations

import json
import os
import sys
from functools import lru_cache
from pathlib import Path
from typing import Any, Optional

from dotenv import load_dotenv

from google import genai
from google.genai import errors, types

load_dotenv()

from pydantic import ValidationError

from src.schemas.cinematography_plan import (
    CinematographyPlan,
    validate_compliance,
    validate_plan_compliance,
)

GEMINI_API_KEY: Optional[str] = os.environ.get("GEMINI_API_KEY")
GEMINI_MODEL: str = os.environ.get("GEMINI_MODEL", "gemini-3.8-flash")
GEMINI_FALLBACK_MODEL: str = os.environ.get("GEMINI_FALLBACK_MODEL", "gemini-3.7-flash")
GEMINI_FALLBACK_MODEL_2: str = os.environ.get(
    "GEMINI_FALLBACK_MODEL_2", "gemini-3.6-flash"
)

GEMINI_SUPPORTED_SCHEMA_KEYS = frozenset({
    "$id",
    "$defs",
    "$ref",
    "$anchor",
    "type",
    "format",
    "title",
    "description",
    "enum",
    "items",
    "prefixItems",
    "minItems",
    "maxItems",
    "minimum",
    "maximum",
    "anyOf",
    "oneOf",
    "properties",
    "additionalProperties",
    "required",
    "propertyOrdering",
})

_UNSUPPORTED_KEYWORDS = frozenset({
    "exclusiveMinimum",
    "exclusiveMaximum",
    "minLength",
    "maxLength",
    "pattern",
    "default",
    "examples",
    "const",
    "contentEncoding",
    "contentMediaType",
    "contains",
    "$comment",
    "deprecated",
    "readOnly",
    "writeOnly",
    "examples",
    "allOf",
    "not",
    "minProperties",
    "maxProperties",
    "multipleOf",
})


def _sanitize_schema(node: Any) -> Any:
    """Recursively sanitize a JSON Schema to remove Gemini-incompatible keywords."""
    if isinstance(node, dict):
        sanitized: dict[str, Any] = {}
        for key, value in node.items():
            if key in _UNSUPPORTED_KEYWORDS:
                continue
            sanitized[key] = _sanitize_schema(value)

        # Convert exclusiveMinimum/exclusiveMaximum to minimum/maximum where safe
        field_type = sanitized.get("type")
        if "exclusiveMinimum" in node:
            original_min = node["exclusiveMinimum"]
            if field_type == "integer":
                sanitized["minimum"] = original_min + 1
            # for number, drop exclusiveMinimum — Pydantic validation is authoritative
        if "exclusiveMaximum" in node:
            original_max = node["exclusiveMaximum"]
            if field_type == "integer":
                sanitized["maximum"] = original_max - 1
            # for number, drop exclusiveMaximum — Pydantic validation is authoritative

        return sanitized

    if isinstance(node, list):
        return [_sanitize_schema(item) for item in node]

    return node


@lru_cache(maxsize=1)
def build_gemini_response_schema() -> dict[str, Any]:
    """Build a Gemini-compatible JSON Schema from CinematographyPlan.

    The Pydantic-generated schema contains keywords like exclusiveMinimum
    that Google's Gemini structured-output schema rejects. This helper
    produces a sanitized copy compatible with response_json_schema.
    """
    schema = CinematographyPlan.model_json_schema()
    return _sanitize_schema(schema)


class CinematographyAgentError(Exception):
    """Raised when cinematography plan generation fails."""


SYSTEM_PROMPT = """You are a professional cinematography director for a premium vertical technology advertisement.

Your task: Convert the supplied storyboard scene into a practical production-ready shot plan.

SPECIFICATIONS:
- Final advertisement: 9:16, 1080x1920, 30fps
- Total duration: exactly 45 seconds
- Exactly 5 scenes: 0-8s, 8-18s, 18-28s, 28-38s, 38-45s
- Return ONLY valid CinematographyPlan JSON matching the exact schema — no markdown, no extra text

VISUAL PRIORITIES:
- Realistic environments and human subjects
- Cinematic camera language (dolly, push-in, pull-back, handheld, tracking)
- Emotional progression: overload → tension → organization → clarity → calm
- Practical stock-footage production with cinematic color grading
- Restrained typography
- Visual metaphors must be clearly identified as metaphors
- REAL footage/environment should be visually dominant over UI overlays

CAMERA LANGUAGE:
- Slow dolly-in, slow dolly-out
- Controlled handheld with subtle jitter for tension
- Lateral tracking for transitions
- Push-in for emphasis
- Pull-back for reveals
- Shallow depth of field for subject isolation
- Foreground occlusion for depth
- Parallax for layered compositions
- Rack-focus simulation

COMPLIANCE RULES — ABSOLUTELY DO NOT INTRODUCE:
- Guaranteed profits or guaranteed accuracy
- Fake performance statistics or confidence percentages
- Real-looking fake trading results
- Broker execution by CrowdWisdom
- Order confirmation or pre-validated orders
- Unsupported product mechanisms
- Blockchain, cryptographic verification, hashes, immutable records
- Fake live recommendations or specific current stock symbols/prices

Return ONLY the CinematographyPlan structure supplied by the API response schema.
Use the exact property names defined by that schema.
Do not invent alternate property names.
Do not rename fields.
Do not return explanatory text outside the JSON structure.

STORYBOARD IS AUTHORITATIVE — do not change its claims or narrative."""

USER_PROMPT_TEMPLATE = """Convert this approved storyboard into a production-ready cinematography plan.

Storyboard JSON:
{storyboard_json}

Return a complete CinematographyPlan with exactly 5 scenes. Each scene must have:
- scene_id: 1-5
- start_seconds and end_seconds matching the storyboard exactly (0-8, 8-18, 18-28, 28-38, 38-45)
- creative_goal from the scene narration
- shots array with shot_type, subject, environment, camera, camera_motion, lens_feel, composition, depth, lighting, color_grade, mood
- visual descriptions and footage queries must NOT include financial symbols or performance claims
- compliance_notes must reflect financial-compliance safety
- sound_design notes

Timing boundaries are strictly enforced. Shots must fit within scene boundaries.

Return ONLY the JSON object, no surrounding text, no markdown."""


def _require_api_key() -> str:
    """Return the Gemini API key or raise a clear error."""
    key = os.environ.get("GEMINI_API_KEY")
    if not key:
        raise CinematographyAgentError(
            "GEMINI_API_KEY environment variable not set. "
            "Place it in .env or export before running."
        )
    return key


def _generate_with_model(
    client: genai.Client,
    model_name: str,
    prompt: str,
) -> str:
    response = client.models.generate_content(
        model=model_name,
        contents=prompt,
        config=types.GenerateContentConfig(
            system_instruction=SYSTEM_PROMPT,
            temperature=0.2,
            response_mime_type="application/json",
            response_json_schema=build_gemini_response_schema(),
        ),
    )

    parsed = getattr(response, "parsed", None)

    if isinstance(parsed, CinematographyPlan):
        return parsed.model_dump_json()

    if isinstance(parsed, dict):
        try:
            plan = CinematographyPlan.model_validate(parsed)
        except ValidationError as exc:
            raise CinematographyAgentError(
                f"Gemini returned schema-invalid parsed data using {model_name}: {exc}"
            ) from exc
        return plan.model_dump_json()

    text = getattr(response, "text", None)

    if not text:
        raise CinematographyAgentError(
            f"Gemini returned an empty response using {model_name}"
        )

    try:
        plan = CinematographyPlan.model_validate_json(text)
    except ValidationError as exc:
        raise CinematographyAgentError(
            f"Gemini returned schema-invalid JSON using {model_name}: {exc}"
        ) from exc

    return plan.model_dump_json()


def _call_gemini_direct(prompt: str) -> str:
    """Call Gemini with transient 503 recovery and model fallback."""
    if not GEMINI_API_KEY:
        raise CinematographyAgentError(
            "GEMINI_API_KEY is not configured"
        )

    client = genai.Client(api_key=GEMINI_API_KEY)

    models_to_try = [GEMINI_MODEL, GEMINI_FALLBACK_MODEL, GEMINI_FALLBACK_MODEL_2]
    last_exc: Optional[Exception] = None

    for model_name in models_to_try:
        try:
            return _generate_with_model(
                client,
                model_name,
                prompt,
            )
        except errors.ServerError as exc:
            last_exc = exc
            if getattr(exc, "code", None) == 200:
                raise CinematographyAgentError(
                    f"Gemini returned an empty response using {model_name}"
                ) from exc
            if getattr(exc, "code", None) != 503:
                raise CinematographyAgentError(
                    f"Gemini server error using {model_name}: {exc}"
                ) from exc
            if model_name == GEMINI_FALLBACK_MODEL_2:
                raise CinematographyAgentError(
                    f"Gemini models unavailable: {GEMINI_MODEL}, "
                    f"{GEMINI_FALLBACK_MODEL}, {GEMINI_FALLBACK_MODEL_2}: "
                    f"{last_exc}"
                ) from last_exc
            continue
        except Exception as exc:
            last_exc = exc
            raise CinematographyAgentError(
                f"Gemini server error using {model_name}: {exc}"
            ) from exc

    raise CinematographyAgentError(
        f"Gemini request failed: {last_exc}"
    ) from last_exc


def _parse_json_response(raw: str) -> Any:
    """Parse JSON from Gemini response text.

    Does NOT use broad regex cleanup. Extracts the JSON object by finding
    the first '{' and last '}'.
    """
    start = raw.index("{")
    end = raw.rindex("}") + 1
    json_str = raw[start:end]
    return json.loads(json_str)


def _build_prompt(storyboard: dict) -> str:
    """Build the user prompt from the storyboard JSON."""
    return USER_PROMPT_TEMPLATE.format(storyboard_json=json.dumps(storyboard, indent=2))


def _build_stricter_prompt(previous_raw: str, error: str) -> str:
    """Build a stricter retry prompt after a validation failure."""
    return (
        f"STRICT RETRY — previous attempt failed.\n\n"
        f"Error: {error}\n\n"
        f"Previous output (first 300 chars): {previous_raw[:300]}\n\n"
        f"Return ONLY valid CinematographyPlan JSON matching the exact schema. "
        f"Ensure all fields are present, timing is correct (0-8, 8-18, 18-28, "
        f"28-38, 38-45), no forbidden claims, exactly 5 scenes with shots "
        f"fitting within scene boundaries. Do not add any explanatory text. "
        f"No markdown. Return JSON only. "
        f"STRICT JSON output as described in the system prompt."
    )


def _attempt_parse_and_validate(
    raw: str,
    retry: bool = True,
) -> CinematographyPlan:
    """Parse Gemini response and validate schema. Retry once if invalid.

    Steps:
    1. Attempt to parse JSON and validate against schema
    2. On failure, if retry=True, retry with a stricter prompt
    3. Raise CinematographyAgentError if all attempts fail
    """
    attempt = 1
    last_error: Optional[str] = None

    while True:
        try:
            parsed = _parse_json_response(raw)
        except (json.JSONDecodeError, ValueError) as e:
            last_error = f"JSON parse error: {e}"
            if retry and attempt == 1:
                raw = _call_gemini_direct(_build_stricter_prompt(raw, last_error))
                attempt = 2
                continue
            raise CinematographyAgentError(
                f"Failed to parse Gemini response after {attempt} attempt(s): {last_error}"
            )

        try:
            plan = CinematographyPlan.model_validate(parsed)
        except Exception as e:
            last_error = f"Schema validation error: {e}"
            if retry and attempt == 1:
                raw = _call_gemini_direct(_build_stricter_prompt(raw, last_error))
                attempt = 2
                continue
            raise CinematographyAgentError(
                f"Failed to validate plan after {attempt} attempt(s): {last_error}"
            )

        # Compliance check
        compliance = validate_plan_compliance(plan)
        if compliance:
            last_error = f"Compliance violations: {'; '.join(compliance)}"
            if retry and attempt == 1:
                raw = _call_gemini_direct(_build_stricter_prompt(raw, last_error))
                attempt = 2
                continue
            raise CinematographyAgentError(
                f"Compliance violations after {attempt} attempt(s): {compliance}"
            )

        return plan


def generate_cinematography_plan(
    storyboard_path: str | Path,
    output_path: str | Path,
    retry: bool = True,
) -> CinematographyPlan:
    """Load storyboard, call Gemini, validate, and write output plan."""
    storyboard_path = Path(storyboard_path)
    output_path = Path(output_path)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    if not storyboard_path.exists():
        raise CinematographyAgentError(f"Storyboard not found: {storyboard_path}")

    with open(storyboard_path, "r", encoding="utf-8") as f:
        storyboard = json.load(f)

    user_prompt = _build_prompt(storyboard)

    raw_response = _call_gemini_direct(user_prompt)

    plan = _attempt_parse_and_validate(raw_response, retry=retry)

    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(plan.model_dump(), f, indent=2)

    return plan


def main():
    """CLI entrypoint: generate plan from storyboard and write output."""
    storyboard_path = (
        sys.argv[1]
        if len(sys.argv) > 1
        else "outputs/storyboards/final_storyboard.json"
    )
    output_path = (
        sys.argv[2]
        if len(sys.argv) > 2
        else "outputs/visual_prompts/full_cinematography_plan.json"
    )

    plan = generate_cinematography_plan(storyboard_path, output_path)

    print(f"Generated Cinematography Plan: {plan.campaign}")
    print(
        f"Total duration: {plan.total_duration_seconds}s ({len(plan.scenes)} scenes)"
    )
    for scene in plan.scenes:
        shot_count = len(scene.shots)
        print(
            f"  Scene {scene.scene_id}: {scene.start_seconds}s-"
            f"{scene.end_seconds}s, {shot_count} shots"
        )

    compliance = validate_plan_compliance(plan)
    if compliance:
        print(f"WARNING: Compliance issues found: {compliance}", file=sys.stderr)
        sys.exit(1)

    print("Plan validated successfully. Output written to:", output_path)


if __name__ == "__main__":
    main()
